    "Licensing opens with version 1.0. Tungsten Edge is completely free until then, and founding users who have confirmed their email will receive a permanent free license key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权功能将在 1.0 正式版开放。在那之前钨极完全免费；已完成邮箱确认的原始用户，届时会收到永久免费的授权码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licensing opens with version 1.0. Tungsten Edge is completely free until then, and founding users who have confirmed their email will receive a permanent free license key."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權將於1.0版開放。在那之前Tungsten Edge完全免費；已完成電子郵件確認的創始使用者，屆時會收到永久免費的授權碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンス機能はバージョン1.0で開始します。それまでTungsten Edgeは完全に無料で、メールアドレスの確認を済ませた創設ユーザには、永久に無料のライセンスキーをお送りします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lizenzierung startet mit Version 1.0. Bis dahin ist Tungsten Edge vollständig kostenlos, und Gründungsnutzer, die ihre E-Mail-Adresse bestätigt haben, erhalten dann einen dauerhaft kostenlosen Lizenzschlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les licences arriveront avec la version 1.0. D’ici là, Tungsten Edge est entièrement gratuit, et les utilisateurs fondateurs ayant confirmé leur adresse e-mail recevront une clé de licence gratuite à vie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las licencias llegarán con la versión 1.0. Hasta entonces, Tungsten Edge es totalmente gratis, y los usuarios fundadores que hayan confirmado su correo electrónico recibirán una clave de licencia gratuita para siempre."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las licencias llegarán con la versión 1.0. Hasta entonces, Tungsten Edge es totalmente gratis, y los usuarios fundadores que hayan confirmado su correo electrónico recibirán una clave de licencia gratuita para siempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O licenciamento começa com a versão 1.0. Até lá, o Tungsten Edge é totalmente gratuito, e os usuários fundadores que confirmaram o e-mail receberão uma chave de licença gratuita e permanente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O licenciamento arranca com a versão 1.0. Até lá, o Tungsten Edge é totalmente gratuito e os utilizadores fundadores que tenham confirmado o e-mail receberão uma chave de licença gratuita e permanente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le licenze arriveranno con la versione 1.0. Fino ad allora Tungsten Edge è completamente gratuito e gli utenti fondatori che hanno confermato la propria email riceveranno una chiave di licenza gratuita e permanente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스는 버전 1.0부터 시작됩니다. 그때까지 Tungsten Edge는 완전히 무료이며, 이메일 주소 확인을 완료한 창립 멤버에게는 영구 무료 라이선스 키가 제공됩니다."
          }
        }
      }
    },
