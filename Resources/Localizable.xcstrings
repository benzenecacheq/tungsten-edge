    "Couldn’t start a new instance of Tungsten Edge: %@\n\nYou can click Retry, or quit and open it manually from your Applications folder.": {
      "comment": "%@ 是系统返回的错误描述",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能启动新的钨极实例：%@\n\n可以点“重试”，或者退出后从“应用程序”手动打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t start a new instance of Tungsten Edge: %@\n\nYou can click Retry, or quit and open it manually from your Applications folder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動新的Tungsten Edge：%@\n\n可以按一下「重試」，或先結束，再從「應用程式」檔案夾手動打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edgeの新しいインスタンスを起動できませんでした: %@\n\n「再試行」をクリックするか、いったん終了して「アプリケーション」フォルダから手動で開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Instanz von Tungsten Edge konnte nicht gestartet werden: %@\n\nDu kannst auf „Erneut versuchen“ klicken oder Tungsten Edge beenden und von Hand aus dem Ordner „Programme“ öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lancer une nouvelle instance de Tungsten Edge : %@\n\nVous pouvez cliquer sur Réessayer, ou quitter puis l’ouvrir manuellement depuis votre dossier Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar una nueva instancia de Tungsten Edge: %@\n\nPuedes hacer clic en Reintentar, o salir de la app y abrirla manualmente desde la carpeta Aplicaciones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar una nueva instancia de Tungsten Edge: %@\n\nPuedes hacer clic en Reintentar, o salir de la app y abrirla manualmente desde la carpeta Aplicaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar uma nova instância do Tungsten Edge: %@\n\nVocê pode clicar em Tentar Novamente, ou encerrar e abri-lo manualmente a partir da pasta Aplicativos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar uma nova instância do Tungsten Edge: %@\n\nPode clicar em Voltar a tentar ou sair e abri-lo manualmente a partir da pasta Aplicações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare una nuova istanza di Tungsten Edge: %@\n\nPuoi fare clic su Riprova oppure uscire e aprirlo manualmente dalla cartella Applicazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tungsten Edge를 새로 시작할 수 없습니다: %@\n\n재시도를 클릭하거나, 종료한 후 응용 프로그램 폴더에서 직접 여십시오."
          }
        }
      }
    },
